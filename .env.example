# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # chave "anon"/"publishable"
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # chave "service_role" — NUNCA expor no navegador

# --- E-mail (https://resend.com) ---
RESEND_API_KEY=re_...
EMAIL_FROM="Licenças <alertas@seudominio.com.br>"   # domínio verificado no Resend (para testes: onboarding@resend.dev)

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000       # em produção: https://seu-app.vercel.app
CRON_SECRET=troque-por-um-segredo-longo         # protege /api/cron/alertas (a Vercel envia automaticamente)
