# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # chave "anon"/"publishable"
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # chave "service_role" — NUNCA expor no navegador

# --- E-mail (https://resend.com) ---
RESEND_API_KEY=re_...
EMAIL_FROM="Licenças <alertas@seudominio.com.br>"   # domínio verificado no Resend (para testes: onboarding@resend.dev)

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000       # em produção: https://seu-app.vercel.app
CRON_SECRET=troque-por-um-segredo-longo         # protege /api/cron/alertas (a Vercel envia automaticamente)

# --- Leitura de documentos por IA (opcional) — configure UMA das chaves ---
# Gemini (Google) — plano gratuito: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash        # padrão (cai para gemini-3.5-flash-lite se faltar cota)
# Claude (Anthropic) — pago, não usa os dados para treino: https://platform.claude.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# IA_LIMITE_DIARIO=30                  # leituras por IA por organização a cada 24 h
# IA_PROVEDOR=claude                  # força o Claude quando as duas chaves existem
